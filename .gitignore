# Godot editor/import cache. Keep source-side .import and .uid files tracked.
.godot/

# IDE and user-specific settings
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET build output
**/[Bb]in/
**/[Oo]bj/

# Godot/Android/desktop export output
/client/build/
/client/builds/
/editor/builds/
/builds/
*.apk
*.aab
*.apks
*.idsig

# Export credentials and signing keys are always local
.godot/export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# Locally installed research binaries
*.jar

# Development-only test content; never ship this in a public build.
/client/testdata/

# Local-only design workspace and upstream interaction-reference snapshot.
# Keep shipped client/editor assets, generators, notices, and other licenses tracked.
/design/
/third_party/dynamaker-modified-reference/

# Generated tool assets and Python caches
/tools/.venv/
/tools/style_refs.json
/local-generated/
**/__pycache__/
*.py[cod]

# Local visual verification output
/gui-test-screenshots/
/tmp_editor_check/
/tmp_shots/
/.tmp/
/.analysis-literal-probe/
/analysis_literal_probe/
/editor-ui-check.png
/editor-ui-workbench.png
/editor-gui.log
/editor-gui.err
/editor-split.log
/editor-split.err

# Locally compiled research utility
/tools/memscan/memscan
/tmp-authoring*.dll
/editor-static-check.dll
/editor-restore.log
/editor-restore-projectref.log
/restore2.log
/godot-editor-smoke.log
/godot-editor-editor-mode.log
/tmp_godot_userdata*/

# Local agent/session metadata
/.zcode/
# AGENTS.md 必须保持被跟踪：tools/core-tests 的 FindRepositoryRoot 以它为仓库根哨兵。

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
