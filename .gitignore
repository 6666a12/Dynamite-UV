# Godot editor/import cache. Keep source-side .import and .uid files tracked.
.godot/

# IDE and user-specific settings
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# .NET build output
**/[Bb]in/
**/[Oo]bj/

# Godot/Android export output
/client/build/
/builds/
*.apk
*.aab
*.apks
*.idsig

# Export credentials and signing keys are always local
.godot/export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key

# Locally installed research binaries
*.jar

# Development-only test content; never ship this in a public build.
/client/testdata/

# Generated tool assets and Python caches
/tools/.venv/
/tools/style_refs.json
/local-generated/
**/__pycache__/
*.py[cod]

# Local visual verification output
/gui-test-screenshots/
/tmp_editor_check/
/tmp_shots/

# Locally compiled research utility
/tools/memscan/memscan

# Local agent/session metadata
/.zcode/
AGENTS.md

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
