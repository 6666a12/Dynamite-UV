{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dynamite-uv:schema:chart:2.1",
  "title": "Dynamite Universe Chart v2.1",
  "description": "Version 2.1 difficulty. Position-dependent tail constraints, expression compilation, actual scroll/geometry bounds and resource limits also require shared semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "formatMinor",
    "chartId",
    "audioOffsetSec",
    "timing",
    "notesLeft",
    "notesCenter",
    "notesRight"
  ],
  "properties": {
    "format": {
      "const": "dynamite-uv-chart"
    },
    "formatVersion": {
      "const": 2
    },
    "formatMinor": {
      "const": 1
    },
    "chartId": {
      "$ref": "#/$defs/id"
    },
    "audioOffsetSec": {
      "type": "number"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "scrollSpeeds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scrollEvent"
      }
    },
    "notesLeft": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sideNote"
      }
    },
    "notesCenter": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/centerNote"
      }
    },
    "notesRight": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sideNote"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "barTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bar",
        "numerator",
        "denominator"
      ],
      "properties": {
        "bar": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bpms"
      ],
      "properties": {
        "bpms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bpmEvent"
          }
        }
      }
    },
    "bpmEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "bpm"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "bpm": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "scrollCurve": {
      "enum": [
        "linear",
        "hold",
        "easeInQuad",
        "easeOutQuad",
        "easeInOutQuad",
        "easeInCubic",
        "easeOutCubic",
        "easeInOutCubic",
        "easeInSine",
        "easeOutSine",
        "easeInOutSine",
        "custom"
      ]
    },
    "pathCurve": {
      "enum": [
        "linear",
        "hold",
        "easeInQuad",
        "easeOutQuad",
        "easeInOutQuad",
        "easeInCubic",
        "easeOutCubic",
        "easeInOutCubic",
        "easeInSine",
        "easeOutSine",
        "easeInOutSine",
        "smooth",
        "custom"
      ]
    },
    "scrollEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time",
        "value"
      ],
      "properties": {
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64
        },
        "curveToNext": {
          "$ref": "#/$defs/scrollCurve"
        },
        "customExpr": {
          "$ref": "#/$defs/expression"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/outgoingCustom"
        }
      ]
    },
    "center": {
      "type": "number"
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "noteScrollSpeedMultiplier": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 1.0
    },
    "normalNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "time",
        "center",
        "width"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "tap",
            "drag",
            "exTap",
            "mine",
            "barLine"
          ]
        },
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "center": {
          "$ref": "#/$defs/center"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "scrollSpeedMultiplier": {
          "$ref": "#/$defs/noteScrollSpeedMultiplier"
        }
      }
    },
    "holdNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "time",
        "center",
        "width",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "hold"
        },
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "center": {
          "$ref": "#/$defs/center"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "scrollSpeedMultiplier": {
          "$ref": "#/$defs/noteScrollSpeedMultiplier"
        },
        "curveToNext": {
          "$ref": "#/$defs/pathCurve"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/holdNode"
          }
        },
        "customExpr": {
          "$ref": "#/$defs/expression"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/outgoingCustom"
        }
      ]
    },
    "mixerNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "time",
        "center",
        "width",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "mixer"
        },
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "center": {
          "$ref": "#/$defs/center"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "scrollSpeedMultiplier": {
          "$ref": "#/$defs/noteScrollSpeedMultiplier"
        },
        "curveToNext": {
          "$ref": "#/$defs/pathCurve"
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mixerNode"
          }
        },
        "customExpr": {
          "$ref": "#/$defs/expression"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/outgoingCustom"
        }
      ]
    },
    "holdNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "time",
        "center",
        "width"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "center": {
          "$ref": "#/$defs/center"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "curveToNext": {
          "$ref": "#/$defs/pathCurve"
        },
        "judge": {
          "type": "boolean"
        },
        "customExpr": {
          "$ref": "#/$defs/expression"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/outgoingCustom"
        }
      ]
    },
    "mixerNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "time",
        "center",
        "width"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "time": {
          "$ref": "#/$defs/barTime"
        },
        "center": {
          "$ref": "#/$defs/center"
        },
        "width": {
          "$ref": "#/$defs/width"
        },
        "curveToNext": {
          "$ref": "#/$defs/pathCurve"
        },
        "customExpr": {
          "$ref": "#/$defs/expression"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/outgoingCustom"
        }
      ]
    },
    "sideNote": {
      "oneOf": [
        {
          "$ref": "#/$defs/normalNote"
        },
        {
          "$ref": "#/$defs/holdNote"
        },
        {
          "$ref": "#/$defs/mixerNote"
        }
      ]
    },
    "centerNote": {
      "oneOf": [
        {
          "$ref": "#/$defs/normalNote"
        },
        {
          "$ref": "#/$defs/holdNote"
        },
        {
          "$ref": "#/$defs/mixerNote"
        }
      ]
    },
    "expression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "outgoingCustom": {
      "if": {
        "required": [
          "curveToNext"
        ],
        "properties": {
          "curveToNext": {
            "const": "custom"
          }
        }
      },
      "then": {
        "required": [
          "customExpr"
        ]
      },
      "else": {
        "not": {
          "required": [
            "customExpr"
          ]
        }
      }
    }
  }
}
