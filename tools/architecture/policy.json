{
  "source_roots": [
    "client/scripts",
    "editor/scripts",
    "presentation",
    "shared",
    "tools/chart-editor-core",
    "tools/core-tests",
    "tools/chart-editor-tests"
  ],
  "pure_roots": [
    "shared",
    "tools/chart-editor-core"
  ],
  "default_file_limit": 1000,
  "source_boundaries": [
    {
      "files": [
        "client/scripts/game/GameplayNoteRenderer*.cs",
        "client/scripts/game/GameplayEffects.cs"
      ],
      "forbidden": "\\b(?:JudgeEngine|JudgeUnit|SustainRuntime|GameplayMain|GameSession)\\b",
      "reason": "render components must not depend on scene/judge objects or fetch global session state"
    },
    {
      "files": [
        "client/scripts/ui/SongBrowseState.cs"
      ],
      "forbidden": "\\b(?:Godot|GameSession|ChartPack|AudioStreamPlayer)\\b",
      "reason": "browse state must remain independent of engine, session and loading adapters"
    },
    {
      "files": [
        "client/scripts/game/GameplayHud.cs"
      ],
      "forbidden": "\\b(?:JudgeEngine|JudgeUnit|GameplayMain|GameSession)\\b",
      "reason": "HUD receives display values and callbacks, not scene/judge/session objects"
    },
    {
      "files": [
        "client/scripts/game/GameplayPauseOverlay.cs"
      ],
      "forbidden": "\\b(?:JudgeEngine|JudgeUnit|SustainRuntime|GameplayMain|GameSession)\\b",
      "reason": "pause overlay owns visual state and receives host callbacks instead of scene, judge or session objects"
    },
    {
      "files": [
        "client/scripts/ui/SongPreviewPlayer.cs",
        "client/scripts/ui/CalibrationBeatSource.cs"
      ],
      "forbidden": "\\bGameSession\\b",
      "reason": "audio lifecycle components must not fetch global selection or settings"
    },
    {
      "files": [
        "client/scripts/ui/SongSelectWidgets.cs",
        "client/scripts/ui/SettingsWidgets.cs",
        "client/scripts/ui/CalibrationWidgets.cs"
      ],
      "forbidden": "\\bGameSession\\b",
      "reason": "widgets receive current motion/speed providers instead of global session access"
    },
    {
      "files": [
        "client/scripts/ui/SongDetailCard.cs"
      ],
      "forbidden": "\\b(?:GameSession|SongSelect)\\b",
      "reason": "the detail card receives motion profile and display values from its page instead of reading session or host state"
    },
    {
      "files": [
        "client/scripts/ui/SongDetailRequest.cs"
      ],
      "forbidden": "\\b(?:Godot|GameSession|ChartPack|AudioStreamPlayer|SongSelect)\\b",
      "reason": "detail request generation and loading stay independent of the engine, session, chart packs and the host page"
    },
    {
      "files": [
        "editor/scripts/EditorStartPage.cs",
        "editor/scripts/EditorHudView.cs",
        "editor/scripts/EditorSettingsPage.cs",
        "editor/scripts/EditorContextMenu.cs"
      ],
      "forbidden": "\\bStandaloneEditorMain\\b",
      "reason": "editor page components must not depend on the shell"
    },
    {
      "files": [
        "presentation/**/*.cs"
      ],
      "forbidden": "\\b(?:GameSession|GameSettings|GameplayMain|StandaloneEditorMain|EditorSettings|ChartPack)\\b",
      "reason": "the common visual assembly must not depend on either application or its settings"
    }
  ],
  "file_limits": {
    "client/scripts/game/GameplayMain.cs": 320,
    "client/scripts/ui/SongSelect.cs": 260,
    "editor/scripts/EditorFlow.cs": 360,
    "editor/scripts/StandaloneEditorMain.cs": 420,
