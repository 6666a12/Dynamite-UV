<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CoreTests</RootNamespace>
    <!-- 本机只有 .NET 10 运行时，允许前滚 -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/DynamiteUniverse.Shared.csproj" />
    <!-- The result clock is deliberately Godot-free: verify opaque loading/skip semantics. -->
    <Compile Include="../../presentation/ui/UiMotionMode.cs" Link="Ui/UiMotionMode.cs" />
    <Compile Include="../../client/scripts/ui/results/ResultRevealTimeline.cs" Link="Ui/ResultRevealTimeline.cs" />
    <Compile Include="../../client/scripts/ui/transitions/TrackHandoffState.cs" Link="Ui/TrackHandoffState.cs" />
    <Compile Include="../../client/scripts/game/settings/GameSettingsCodec.cs" Link="Game/GameSettingsCodec.cs" />
    <!-- The calibration statistics core is Godot-free too: verify median/spread/suggestion. -->
    <Compile Include="../../client/scripts/ui/calibration/CalibrationStats.cs" Link="Ui/CalibrationStats.cs" />
    <!-- Calibration sampling owns the tap state machine without Godot: verify warmup/sampling rules. -->
    <Compile Include="../../client/scripts/ui/calibration/CalibrationSampling.cs" Link="Ui/CalibrationSampling.cs" />
    <!-- Palette editing transactions and snapshots are intentionally independent of Godot. -->
    <Compile Include="../../client/scripts/ui/note_colors/NotePaletteDraft.cs" Link="Ui/NotePaletteDraft.cs" />
    <Compile Include="../../client/scripts/ui/song_select/SongBrowseState.cs" Link="Ui/SongBrowseState.cs" />
    <Compile Include="../../client/scripts/ui/song_select/SongListScrollState.cs" Link="Ui/SongListScrollState.cs" />
    <Compile Include="../../client/scripts/ui/common/ScrollInertia.cs" Link="Ui/ScrollInertia.cs" />
    <Compile Include="../../client/scripts/ui/song_select/SongCardMotion.cs" Link="Ui/SongCardMotion.cs" />
    <Compile Include="../../client/scripts/ui/common/UiEase.cs" Link="Ui/UiEase.cs" />
    <!-- Detail request generation and single in-flight loading are Godot-free too. -->
    <Compile Include="../../client/scripts/ui/song_select/SongDetailRequest.cs" Link="Ui/SongDetailRequest.cs" />
    <!-- Result outcome classification, prelude clock and input guard are pure C#. -->
    <Compile Include="../../client/scripts/ui/results/ResultOutcome.cs" Link="Ui/ResultOutcome.cs" />
    <Compile Include="../../client/scripts/ui/results/ResultPreludeTimeline.cs" Link="Ui/ResultPreludeTimeline.cs" />
    <Compile Include="../../client/scripts/ui/results/ResultInputGuard.cs" Link="Ui/ResultInputGuard.cs" />
    <!-- Normal-completion latch is Godot-free: verify the late-take dual latch and fallbacks. -->
    <Compile Include="../../client/scripts/game/gameplay/BleedHudState.cs" Link="Gameplay/BleedHudState.cs" />
    <Compile Include="../../client/scripts/game/gameplay/GameplayProgressState.cs" Link="Gameplay/GameplayProgressState.cs" />
    <Compile Include="../../client/scripts/game/gameplay/JudgmentLineTimeline.cs" Link="Gameplay/JudgmentLineTimeline.cs" />
    <Compile Include="../../client/scripts/game/gameplay/HudLightState.cs" Link="Gameplay/HudLightState.cs" />
    <Compile Include="../../client/scripts/game/gameplay/GameplayEndCondition.cs" Link="Gameplay/GameplayEndCondition.cs" />
    <None Include="Fixtures/synthetic_chart.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
