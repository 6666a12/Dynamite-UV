<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CoreTests</RootNamespace>
    <!-- 本机只有 .NET 10 运行时，允许前滚 -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/DynamiteUniverse.Shared.csproj" />
    <!-- The result clock is deliberately Godot-free: verify opaque loading/skip semantics. -->
    <Compile Include="../../presentation/ui/UiMotionMode.cs" Link="Ui/UiMotionMode.cs" />
    <Compile Include="../../client/scripts/ui/ResultRevealTimeline.cs" Link="Ui/ResultRevealTimeline.cs" />
    <!-- The calibration statistics core is Godot-free too: verify median/spread/suggestion. -->
    <Compile Include="../../client/scripts/ui/CalibrationStats.cs" Link="Ui/CalibrationStats.cs" />
    <!-- Calibration sampling owns the tap state machine without Godot: verify warmup/sampling rules. -->
    <Compile Include="../../client/scripts/ui/CalibrationSampling.cs" Link="Ui/CalibrationSampling.cs" />
    <!-- Palette editing transactions and snapshots are intentionally independent of Godot. -->
    <Compile Include="../../client/scripts/ui/NotePaletteDraft.cs" Link="Ui/NotePaletteDraft.cs" />
    <Compile Include="../../client/scripts/ui/SongBrowseState.cs" Link="Ui/SongBrowseState.cs" />
    <Compile Include="../../client/scripts/ui/SongCardMotion.cs" Link="Ui/SongCardMotion.cs" />
    <Compile Include="../../client/scripts/ui/UiEase.cs" Link="Ui/UiEase.cs" />
    <!-- Detail request generation and single in-flight loading are Godot-free too. -->
    <Compile Include="../../client/scripts/ui/SongDetailRequest.cs" Link="Ui/SongDetailRequest.cs" />
    <None Include="Fixtures/synthetic_chart.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
