<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../chart-editor/Localization/EditorLocalization.cs" Link="Localization/EditorLocalization.cs" />
    <Compile Include="../chart-editor/Settings/EditorPreferences.cs" Link="Settings/EditorPreferences.cs" />
    <EmbeddedResource Include="../chart-editor/Resources/Strings.resx" Link="Resources/Strings.resx"
                      LogicalName="DynamiteUniverse.ChartEditor.Resources.Strings.resources" />
    <EmbeddedResource Include="../chart-editor/Resources/Strings.zh-CN.resx" Link="Resources/Strings.zh-CN.resx"
                      LogicalName="DynamiteUniverse.ChartEditor.Resources.Strings.zh-CN.resources" />
  </ItemGroup>
</Project>
