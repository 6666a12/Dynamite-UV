<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:DynamiteUniverse.ChartEditor.Controls"
             x:Class="DynamiteUniverse.ChartEditor.Views.StartPage">
  <Grid x:Name="RootGrid">
    <controls:SignalBackdrop />
    <Grid Margin="54,40,54,36" RowDefinitions="Auto,*,Auto">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
        <Border Classes="brandMark" Width="42" Height="42">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="20" FontWeight="Bold" Text="D" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
          <controls:LocalizedText Classes="eyebrow" Key="Welcome.Eyebrow" />
          <controls:LocalizedText Classes="dim" FontSize="12" Key="Welcome.Subtitle" />
        </StackPanel>
        <controls:LanguageButton Grid.Column="2" Classes="quiet" />
      </Grid>

      <Grid Grid.Row="1" Margin="20,0" Width="980" HorizontalAlignment="Center"
            VerticalAlignment="Center" ColumnDefinitions="540,36,404">
        <StackPanel Grid.Column="0" Spacing="18" Margin="0,0,24,0">
          <controls:SignalIcon Kind="NavigateMain" Width="74" Height="74"
                               Foreground="{StaticResource CommunityCyan}" StrokeThickness="1.2" />
          <controls:LocalizedText FontSize="45" FontWeight="SemiBold" LetterSpacing="-0.7"
                                  LineHeight="49" TextWrapping="Wrap" Key="Welcome.Tagline" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="signalPill" ToolTip.Tip="Fixed 1920×1080 authoring coordinates">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:SignalIcon Kind="Grid" Width="16" Height="16" />
                <TextBlock Classes="micro" Text="1920 × 1080" />
              </StackPanel>
            </Border>
            <Border Classes="signalPill" ToolTip.Tip="Strict deterministic v2 package output">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <controls:SignalIcon Kind="NavigateValidation" Width="16" Height="16" />
                <TextBlock Classes="micro" Text="STRICT V2" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Width="404" Spacing="12" VerticalAlignment="Center">
          <Button Classes="launch primary" Click="NewProjectClicked"
                  AutomationProperties.Name="New project">
            <Grid ColumnDefinitions="Auto,*">
              <controls:SignalIcon Kind="NavigateProject" Width="30" Height="30"
                                   VerticalAlignment="Center" Margin="0,0,18,0" />
              <StackPanel Grid.Column="1" Spacing="4">
                <controls:LocalizedText FontSize="21" FontWeight="SemiBold" Key="Welcome.NewProject" />
                <controls:LocalizedText FontSize="12" Opacity="0.70" Key="Welcome.NewProjectHint" />
              </StackPanel>
            </Grid>
          </Button>
          <Button Classes="launch secondary" Click="OpenProjectClicked"
                  AutomationProperties.Name="Open v2 package">
            <Grid ColumnDefinitions="Auto,*">
              <controls:SignalIcon Kind="Open" Width="30" Height="30"
                                   VerticalAlignment="Center" Margin="0,0,18,0" />
              <StackPanel Grid.Column="1" Spacing="4">
                <controls:LocalizedText FontSize="20" FontWeight="SemiBold" Key="Welcome.OpenPackage" />
                <controls:LocalizedText Classes="dim" FontSize="12" Key="Welcome.OpenPackageHint" />
              </StackPanel>
            </Grid>
          </Button>
          <Border Classes="infoPanel" Margin="0,6,0,0"
                  ToolTip.Tip="Use community-owned audio, artwork and chart data only. Development testdata cannot be opened here.">
            <Grid ColumnDefinitions="Auto,*" Margin="14,11">
              <controls:SignalIcon Kind="Info" Width="20" Height="20"
                                   Foreground="{StaticResource CommunityPink}" />
              <controls:LocalizedText Grid.Column="1" Margin="12,0,0,0" Classes="dim"
                                      VerticalAlignment="Center" Key="Welcome.CleanRoomBoundary" />
            </Grid>
          </Border>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto">
        <controls:LocalizedText Classes="micro" Key="Welcome.DesktopFooter" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
          <controls:SignalIcon Kind="NavigateValidation" Width="14" Height="14"
                               Foreground="{StaticResource CommunityGreen}" />
          <controls:LocalizedText Classes="statusGood" Key="Welcome.CleanRoomStatus" />
        </StackPanel>
        <StackPanel Grid.Column="2" Margin="24,0,0,0" Orientation="Horizontal" Spacing="7">
          <controls:SignalIcon Kind="Open" Width="14" Height="14"
                               Foreground="{StaticResource CommunityGreen}" />
          <controls:LocalizedText Classes="statusGood" Key="Welcome.StrictOpenStatus" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
