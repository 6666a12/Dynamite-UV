<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <Color x:Key="CommunityBackgroundColor">#060A13</Color>
    <Color x:Key="CommunitySurfaceColor">#0B111E</Color>
    <Color x:Key="CommunitySurfaceRaisedColor">#111A2B</Color>
    <Color x:Key="CommunitySurfaceHighColor">#172338</Color>
    <Color x:Key="CommunityLineColor">#283653</Color>
    <Color x:Key="CommunityLineStrongColor">#425475</Color>
    <Color x:Key="CommunityCyanColor">#35E0FF</Color>
    <Color x:Key="CommunityPinkColor">#FF4D91</Color>
    <Color x:Key="CommunityGreenColor">#53E38D</Color>
    <Color x:Key="CommunityAmberColor">#FFBD59</Color>
    <Color x:Key="CommunityTextColor">#EDF2FF</Color>
    <Color x:Key="CommunityDimColor">#8C99B2</Color>

    <SolidColorBrush x:Key="CommunityBackground" Color="{StaticResource CommunityBackgroundColor}" />
    <SolidColorBrush x:Key="CommunitySurface" Color="{StaticResource CommunitySurfaceColor}" />
    <SolidColorBrush x:Key="CommunitySurfaceRaised" Color="{StaticResource CommunitySurfaceRaisedColor}" />
    <SolidColorBrush x:Key="CommunitySurfaceHigh" Color="{StaticResource CommunitySurfaceHighColor}" />
    <SolidColorBrush x:Key="CommunityLine" Color="{StaticResource CommunityLineColor}" />
    <SolidColorBrush x:Key="CommunityLineStrong" Color="{StaticResource CommunityLineStrongColor}" />
    <SolidColorBrush x:Key="CommunityCyan" Color="{StaticResource CommunityCyanColor}" />
    <SolidColorBrush x:Key="CommunityPink" Color="{StaticResource CommunityPinkColor}" />
    <SolidColorBrush x:Key="CommunityGreen" Color="{StaticResource CommunityGreenColor}" />
    <SolidColorBrush x:Key="CommunityAmber" Color="{StaticResource CommunityAmberColor}" />
    <SolidColorBrush x:Key="CommunityText" Color="{StaticResource CommunityTextColor}" />
    <SolidColorBrush x:Key="CommunityDim" Color="{StaticResource CommunityDimColor}" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource CommunityBackground}" />
    <Setter Property="Foreground" Value="{StaticResource CommunityText}" />
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Microsoft YaHei UI" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{StaticResource CommunityDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.25" />
  </Style>
  <Style Selector="TextBlock.fieldLabel">
    <Setter Property="Foreground" Value="{StaticResource CommunityDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.fieldHint">
    <Setter Property="Foreground" Value="#6F7D98" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.fieldError">
    <Setter Property="Foreground" Value="{StaticResource CommunityPink}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="2" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
  </Style>
  <Style Selector="TextBlock.micro">
    <Setter Property="Foreground" Value="{StaticResource CommunityDim}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.15" />
  </Style>
  <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="{StaticResource CommunityDim}" /></Style>
  <Style Selector="TextBlock.cyan"><Setter Property="Foreground" Value="{StaticResource CommunityCyan}" /></Style>
  <Style Selector="TextBlock.statusGood"><Setter Property="Foreground" Value="{StaticResource CommunityGreen}" /><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="TextBlock.statusWarn"><Setter Property="Foreground" Value="{StaticResource CommunityAmber}" /><Setter Property="FontSize" Value="11" /></Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource CommunitySurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#5E111A2B" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="14" />
  </Style>
  <Style Selector="Border.topBar, Border.bottomBar">
    <Setter Property="Background" Value="#E6080D18" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
  </Style>
  <Style Selector="Border.topBar"><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
  <Style Selector="Border.bottomBar"><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
  <Style Selector="Border.brandMark">
    <Setter Property="Background" Value="#15384A" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Border.signalPill">
    <Setter Property="Background" Value="#AA0D1727" />
    <Setter Property="BorderBrush" Value="#545F7596" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="11,6" />
  </Style>
  <Style Selector="Border.infoPanel">
    <Setter Property="Background" Value="#BE0C1322" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>
  <Style Selector="Border.formSection">
    <Setter Property="Background" Value="#EE0C1321" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.formSection.accentSection">
    <Setter Property="BorderBrush" Value="#5543CDE7" />
    <Setter Property="Background" Value="#F00D1727" />
  </Style>
  <Style Selector="Border.projectSummary">
    <Setter Property="Background" Value="#E80A111D" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.draftNotice">
    <Setter Property="Background" Value="#1AFFBD59" />
    <Setter Property="BorderBrush" Value="#66FFBD59" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Background" Value="#111A2B" />
    <Setter Property="Foreground" Value="{StaticResource CommunityText}" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="34" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLineStrong}" />
    <Setter Property="Background" Value="#18243A" />
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter"><Setter Property="Opacity" Value="0.82" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.36" /></Style>
  <Style Selector="Button.quiet">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource CommunityDim}" />
  </Style>
  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="#10192A" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLineStrong}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource CommunityCyan}" />
    <Setter Property="Foreground" Value="#03141B" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.warn">
    <Setter Property="Foreground" Value="#FFD8E7" />
    <Setter Property="BorderBrush" Value="#8D365A" />
    <Setter Property="Background" Value="#25131F" />
  </Style>
  <Style Selector="Button.launch">
    <Setter Property="MinHeight" Value="94" />
    <Setter Property="Padding" Value="22,18" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.launch.secondary">
    <Setter Property="Background" Value="#DF0C1422" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLineStrong}" />
  </Style>
  <Style Selector="Button.create"><Setter Property="MinWidth" Value="178" /><Setter Property="MinHeight" Value="42" /></Style>
  <Style Selector="Button.tool">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinHeight" Value="42" />
    <Setter Property="Background" Value="#5E111A2B" />
    <Setter Property="BorderBrush" Value="#313E5A" />
  </Style>
  <Style Selector="Button.tool.selected">
    <Setter Property="Foreground" Value="#04131C" />
    <Setter Property="Background" Value="{StaticResource CommunityCyan}" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.track">
    <Setter Property="Background" Value="#64101828" />
    <Setter Property="BorderBrush" Value="#34425F" />
  </Style>
  <Style Selector="Button.track.selected">
    <Setter Property="Foreground" Value="{StaticResource CommunityCyan}" />
    <Setter Property="Background" Value="#183145" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>
  <Style Selector="Button.pageNav">
    <Setter Property="Width" Value="42" />
    <Setter Property="Height" Value="42" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource CommunityDim}" />
  </Style>
  <Style Selector="Button.pageNav.selected">
    <Setter Property="Foreground" Value="{StaticResource CommunityCyan}" />
    <Setter Property="Background" Value="#183145" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>

  <Style Selector="ComboBox, TextBox">
    <Setter Property="Background" Value="#080E19" />
    <Setter Property="Foreground" Value="{StaticResource CommunityText}" />
    <Setter Property="BorderBrush" Value="{StaticResource CommunityLine}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="ComboBox:focus, TextBox:focus"><Setter Property="BorderBrush" Value="{StaticResource CommunityCyan}" /></Style>
  <Style Selector="CheckBox"><Setter Property="Foreground" Value="{StaticResource CommunityDim}" /></Style>
  <Style Selector="Slider"><Setter Property="Foreground" Value="{StaticResource CommunityCyan}" /></Style>
</Styles>
