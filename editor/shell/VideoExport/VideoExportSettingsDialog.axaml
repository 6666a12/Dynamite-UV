<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DynamiteUniverse.Editor.Shell"
        x:Class="DynamiteUniverse.Editor.Shell.VideoExport.VideoExportSettingsDialog"
        Width="660" Height="690" MinWidth="490" MinHeight="390"
        WindowStartupLocation="CenterOwner"
        Title="{local:Tr VideoExport.Title}"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}"
        FontFamily="{DynamicResource OfficialFont}">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="14" Margin="22,18" KeyboardNavigation.TabNavigation="Cycle">
    <StackPanel Spacing="5">
      <TextBlock Classes="section" FontSize="20" Text="{local:Tr VideoExport.Title}" />
      <TextBlock x:Name="SourceText" FontSize="15" TextWrapping="Wrap" />
      <TextBlock x:Name="UnsavedHint" Classes="caption" TextWrapping="Wrap" Text="{local:Tr VideoExport.Unsaved}" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14" Margin="0,0,8,1">
        <StackPanel Spacing="8">
          <TextBlock Classes="cyan" Text="{local:Tr VideoExport.Segments}" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{local:Tr VideoExport.Preview}" />
              <NumericUpDown x:Name="PreviewValue" Minimum="0" Maximum="60" Value="2" Increment="0.1" FormatString="0.0##"
                             HorizontalAlignment="Stretch" ValueChanged="OptionsChanged" AutomationProperties.Name="{local:Tr VideoExport.Preview}" />
              <TextBlock x:Name="PreviewHint" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{local:Tr VideoExport.ResultHold}" />
              <NumericUpDown x:Name="ResultHoldValue" Minimum="0" Maximum="60" Value="2" Increment="0.1" FormatString="0.0##"
                             HorizontalAlignment="Stretch" ValueChanged="OptionsChanged" AutomationProperties.Name="{local:Tr VideoExport.ResultHold}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{local:Tr VideoExport.ResultHint}" />
            </StackPanel>
          </Grid>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" />
        <Grid ColumnDefinitions="*,140" ColumnSpacing="14">
          <StackPanel Spacing="4">
            <TextBlock Classes="cyan" Text="{local:Tr VideoExport.FallSpeed}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{local:Tr VideoExport.FallSpeedHint}" />
          </StackPanel>
          <ComboBox x:Name="FallSpeedValue" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                    SelectionChanged="OptionsChanged" AutomationProperties.Name="{local:Tr VideoExport.FallSpeed}" />
        </Grid>
        <Border Height="1" Background="{DynamicResource Line}" />
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBlock Classes="cyan" Text="{local:Tr VideoExport.Video}" />
            <TextBlock Grid.Column="1" Classes="caption" Text="{local:Tr VideoExport.Specs}" />
          </Grid>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <StackPanel Spacing="4">
              <TextBlock Text="{local:Tr VideoExport.Format}" />
              <ComboBox x:Name="CodecValue" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="CodecChanged"
                        AutomationProperties.Name="{local:Tr VideoExport.Format}">
                <ComboBoxItem Content="{local:Tr VideoExport.H264}" />
                <ComboBoxItem Content="{local:Tr VideoExport.Hevc}" />
                <ComboBoxItem Content="{local:Tr VideoExport.Av1}" />
              </ComboBox>
              <TextBlock x:Name="CodecHint" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="{local:Tr VideoExport.Speed}" />
              <ComboBox x:Name="PresetValue" SelectedIndex="1" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{local:Tr VideoExport.Speed}">
                <ComboBoxItem Content="{local:Tr VideoExport.Slow}" />
                <ComboBoxItem Content="{local:Tr VideoExport.Medium}" />
                <ComboBoxItem Content="{local:Tr VideoExport.High}" />
              </ComboBox>
            </StackPanel>
          </Grid>
          <Expander Header="{local:Tr VideoExport.Advanced}" HorizontalAlignment="Stretch" IsExpanded="False">
            <Grid ColumnDefinitions="100,*" ColumnSpacing="10">
              <NumericUpDown x:Name="CrfValue" Minimum="0" Maximum="51" Value="16" Increment="1" FormatString="0"
                             ValueChanged="OptionsChanged" AutomationProperties.Name="{local:Tr VideoExport.Crf}" />
              <TextBlock x:Name="CrfHint" Grid.Column="1" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap" />
            </Grid>
          </Expander>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" />
        <StackPanel Spacing="7">
          <TextBlock Classes="cyan" Text="{local:Tr VideoExport.Output}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="OutputValue" TextChanged="OptionsChanged" AutomationProperties.Name="{local:Tr VideoExport.Output}" />
            <Button x:Name="BrowseOutputButton" Grid.Column="1" Click="BrowseOutputClicked" Content="{local:Tr VideoExport.Browse}" />
          </Grid>
          <TextBlock x:Name="OutputHint" Classes="pink" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="cyan" Text="FFmpeg" />
            <TextBlock x:Name="EncoderStatus" Classes="caption" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="EncoderPath" Classes="caption" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button x:Name="LocateButton" Grid.Column="1" VerticalAlignment="Center" Click="LocateClicked" Content="{local:Tr VideoExport.Locate}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button IsCancel="True" Click="CancelClicked" Content="{local:Tr Create.Cancel}" />
      <Button x:Name="StartButton" IsEnabled="False" IsDefault="True" Classes="accent" Click="StartClicked" Content="{local:Tr VideoExport.Start}" />
    </StackPanel>
  </Grid>
</Window>
