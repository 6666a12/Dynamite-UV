<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DynamiteUniverse.Editor.Shell" x:Class="DynamiteUniverse.Editor.Shell.CustomCurveEditor">
  <StackPanel Spacing="5">
    <StackPanel x:Name="FormulaFields" Spacing="5" IsVisible="False">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Classes="eyebrow" Text="{local:Tr Curve.Formula}" VerticalAlignment="Center" />
        <local:ContextHelpButton Text="{local:Tr Curve.Hint}" />
      </StackPanel>
      <TextBox x:Name="ExpressionInput" Classes="workbench-field" PlaceholderText="t*t*(3-2*t)" />
      <Border Classes="panel" Padding="5" Background="{DynamicResource Bg}">
        <local:CurvePlot x:Name="PreviewPlot" Height="75" />
      </Border>
      <TextBlock x:Name="FormulaNotice" Classes="pink" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
    <Button x:Name="DiscardFormula" Content="{local:Tr Curve.Discard}" Classes="ghost" HorizontalAlignment="Left" IsVisible="False" />
  </StackPanel>
</UserControl>