<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DynamiteUniverse.Editor.Shell" x:Class="DynamiteUniverse.Editor.Shell.CoverStudioWindow"
        Width="1120" Height="740" MinWidth="780" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" FontFamily="{DynamicResource OfficialFont}" FontSize="13">
  <Window.Styles>
    <Style Selector="WrapPanel.cover-toolbar > :is(Button)">
      <Setter Property="Height" Value="32" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,9,4" />
    </Style>
    <Style Selector="Expander.cover-section">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="TextBlock.cover-heading">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Dim}" />
    </Style>
    <Style Selector="StackPanel.cover-fields TextBox, StackPanel.cover-fields NumericUpDown, StackPanel.cover-fields CheckBox">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,*,Auto" Margin="14" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="3">
        <TextBlock x:Name="ProjectTitle" FontSize="22" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{local:Tr Cover.NoWrite}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
        <Button x:Name="UndoCover" Content="{local:Tr Edit.Undo}" Click="UndoClicked" />
        <Button x:Name="RedoCover" Content="{local:Tr Edit.Redo}" Click="RedoClicked" />
      </StackPanel>
    </Grid>
    <TabControl x:Name="Modes" Grid.Row="1" SelectionChanged="ModeChanged">
      <TabItem Header="{local:Tr Cover.Square}">
        <Grid ColumnDefinitions="*,252" ColumnSpacing="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,*" RowSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Classes="cover-heading" Text="{local:Tr Cover.CropCanvas}" VerticalAlignment="Center" />
              <local:ContextHelpButton Text="{local:Tr Cover.CropHelp}" />
            </StackPanel>
            <Border Grid.Row="1" x:Name="CropHost" />
          </Grid>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="cover-fields" Spacing="5" Margin="0,0,6,0">
              <Expander Classes="cover-section" Header="{local:Tr Cover.Source}" IsExpanded="True">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="SourceName" Classes="caption" TextWrapping="Wrap" />
                  <Button Content="{local:Tr Cover.Open}" Click="BrowseClicked" />
                </StackPanel>
              </Expander>
              <Expander Classes="cover-section" Header="{local:Tr Cover.CropRegion}" IsExpanded="True">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="CropReadout" Classes="caption" />
                  <Button x:Name="ResetCrop" Content="{local:Tr Cover.ResetCrop}" Click="ResetCropClicked" />
                  <Border x:Name="CropPreviewHost" Width="112" Height="112" HorizontalAlignment="Left"
                          AutomationProperties.Name="{local:Tr Cover.SquarePreview}" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
      <TabItem Header="{local:Tr Cover.Wide}">
        <Grid ColumnDefinitions="*,252" ColumnSpacing="14" Margin="0,8,0,0">
          <Grid RowDefinitions="Auto,*" RowSpacing="4">
            <WrapPanel Classes="cover-toolbar">
              <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,9,4" VerticalAlignment="Center">
                <ToggleButton x:Name="FramingToggle" Content="{local:Tr Cover.Frame}" IsCheckedChanged="PreviewSettingsChanged"
                              Height="32" VerticalAlignment="Center" VerticalContentAlignment="Center" />
                <local:ContextHelpButton x:Name="WideHelp" />
              </StackPanel>
              <CheckBox x:Name="SnapToggle" IsChecked="True" Content="{local:Tr Cover.Snap}" />
              <CheckBox x:Name="TopToggle" IsChecked="True" Content="{local:Tr Cover.TopBar}" IsCheckedChanged="TopChanged" />
              <Button x:Name="Recenter" Content="{local:Tr Cover.Recenter}" Click="RecenterClicked" />
            </WrapPanel>
            <Border Grid.Row="1" x:Name="WideHost" />
          </Grid>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Classes="cover-fields" Spacing="5" Margin="0,0,6,0">
              <Expander x:Name="FramingOptions" Classes="cover-section" Header="{local:Tr Cover.Frame}" IsExpanded="True" IsVisible="False">
                <StackPanel Spacing="6">
                  <TextBlock Classes="caption" Text="{local:Tr Cover.Zoom}" />
                  <Slider x:Name="ZoomSlider" Minimum="100" Maximum="400" SmallChange="1" LargeChange="10" Value="100" ValueChanged="ZoomSliderChanged" />
                  <NumericUpDown x:Name="ZoomValue" Minimum="100" Maximum="400" Increment="5" Value="100" FormatString="0" ValueChanged="ZoomChanged" />
                  <Button Content="{local:Tr Cover.ResetFrame}" Click="ResetFrameClicked" />
                </StackPanel>
              </Expander>
              <StackPanel x:Name="BadgeOptions" Spacing="4">
                <TextBlock Classes="cover-heading" Text="{local:Tr Cover.Badges}" Margin="10,3,0,2" />
                <StackPanel x:Name="BadgeRows" Spacing="2" />
              </StackPanel>
              <Expander x:Name="FooterSection" Classes="cover-section" Header="{local:Tr Cover.Copy}" Margin="0,3,0,0">
                <StackPanel Spacing="5">
                  <TextBlock Classes="caption" Text="{local:Tr Create.Title}" />
                  <TextBox x:Name="TrackText" MaxLength="200" LostFocus="CopyChanged" />
                  <TextBlock Classes="caption" Text="{local:Tr Create.Artist}" />
                  <TextBox x:Name="ArtistText" MaxLength="200" LostFocus="CopyChanged" />
                  <TextBlock Classes="caption" Text="{local:Tr Create.Charter}" />
                  <TextBox x:Name="NoterText" MaxLength="400" LostFocus="CopyChanged" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
      <TextBlock Classes="caption" x:Name="CoverStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
        <Button x:Name="ExportSquare" Classes="accent" Content="{local:Tr Cover.ExportSquare}" Click="ExportSquareClicked" />
        <Button x:Name="ExportOverlay" Content="{local:Tr Cover.ExportOverlay}" Click="ExportOverlayClicked" IsVisible="False" />
        <Button x:Name="ExportWide" Classes="accent" Content="{local:Tr Cover.ExportWide}" Click="ExportWideClicked" IsVisible="False" />
      </StackPanel>
    </Grid>
    <!-- Single property editor; moved into the active accordion row after initialization. -->
    <Border x:Name="BadgeEditorParking" IsVisible="False">
      <StackPanel x:Name="BadgeProperties" Classes="cover-fields" Spacing="6">
        <CheckBox x:Name="BadgeVisible" Content="{local:Tr Cover.ShowBadge}" IsCheckedChanged="VisibilityChanged" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
          <StackPanel Spacing="2">
            <TextBlock Classes="caption" Text="X" />
            <NumericUpDown x:Name="BadgeX" Minimum="105" Maximum="1815" Increment="1" FormatString="0.##" ValueChanged="BadgePositionChanged" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="caption" Text="Y" />
            <NumericUpDown x:Name="BadgeY" Minimum="105" Maximum="975" Increment="1" FormatString="0.##" ValueChanged="BadgePositionChanged" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="CustomProperties" Spacing="4">
          <TextBlock Classes="caption" Text="{local:Tr Cover.CustomColor}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <TextBox x:Name="CustomHex" MaxLength="7" />
            <Button Grid.Column="1" Content="{local:Tr Cover.Apply}" Click="ApplyHexClicked" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
