<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DynamiteUniverse.Editor.Shell"
             x:Class="DynamiteUniverse.Editor.Shell.AddDifficultyForm"
             Classes="workbench-form" MaxWidth="720" MaxHeight="760" KeyboardNavigation.TabNavigation="Cycle">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="4">
      <TextBlock Classes="section" Text="{local:Tr File.AddChart}" FontSize="20" />
      <TextBlock x:Name="ReferenceInfo" Classes="caption" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields" Spacing="12" Margin="0,0,10,4">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="{local:Tr Create.ChartId}" />
            <TextBox x:Name="ChartIdValue" Classes="workbench-field" AutomationProperties.Name="{local:Tr Create.ChartId}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="eyebrow" Text="{local:Tr Create.Charter}" />
            <TextBox x:Name="CharterValue" Classes="workbench-field" AutomationProperties.Name="{local:Tr Create.Charter}" />
          </StackPanel>
        </Grid>
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Spacing="4">
            <TextBlock Classes="eyebrow" Text="{local:Tr Create.Difficulty}" />
            <ComboBox x:Name="DifficultyChoice" Classes="workbench-field" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Tr Create.Difficulty}" SelectionChanged="DifficultyChanged">
              <ComboBoxItem Content="CASUAL" /><ComboBoxItem Content="NORMAL" /><ComboBoxItem Content="HARD" />
              <ComboBoxItem Content="MEGA" /><ComboBoxItem Content="GIGA" /><ComboBoxItem Content="TECH" /><ComboBoxItem Content="CUSTOM" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Classes="eyebrow" Text="{local:Tr Create.Level}" />
            <NumericUpDown x:Name="LevelValue" Classes="workbench-field" AutomationProperties.Name="{local:Tr Create.Level}" Minimum="1" Maximum="99" Increment="1" FormatString="0" />
            <CheckBox x:Name="UnratedValue" Content="{local:Tr Create.Unrated}" IsCheckedChanged="DifficultyChanged" />
          </StackPanel>
        </Grid>
        <StackPanel x:Name="CustomKeyField" Spacing="4" IsVisible="False">
          <TextBlock Classes="eyebrow" Text="{local:Tr Create.CustomKey}" /><TextBox x:Name="CustomKeyValue" Classes="workbench-field" AutomationProperties.Name="{local:Tr Create.CustomKey}" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="{local:Tr AddForm.Audio}" />
          <ComboBox x:Name="AudioChoice" Classes="localized workbench-field" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Tr AddForm.Audio}" SelectionChanged="AudioChanged">
            <ComboBoxItem Content="{local:Tr AddForm.CurrentAudio}" />
            <ComboBoxItem x:Name="PackAudioOption" Content="{local:Tr AddForm.PackAudio}" />
            <ComboBoxItem Content="{local:Tr AddForm.ExternalAudio}" />
          </ComboBox>
          <Grid x:Name="FileField" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
            <TextBox x:Name="AudioPathValue" Classes="workbench-field" AutomationProperties.Name="{local:Tr AddForm.AudioPath}" PlaceholderText="{local:Tr AddForm.AudioPath}" TextChanged="ExternalChanged" />
            <Button Grid.Column="1" Classes="workbench-field" Content="{local:Tr Create.Browse}" Click="BrowseAudio" />
          </Grid>
          <TextBlock x:Name="AudioInfo" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="{local:Tr AddForm.Timing}" />
          <ComboBox x:Name="TimingChoice" Classes="localized workbench-field" HorizontalAlignment="Stretch" AutomationProperties.Name="{local:Tr AddForm.Timing}" SelectionChanged="TimingChanged">
            <ComboBoxItem Content="{local:Tr AddForm.ChooseTiming}" />
            <ComboBoxItem Content="{local:Tr AddForm.CopyTiming}" />
            <ComboBoxItem Content="{local:Tr AddForm.NewTiming}" />
          </ComboBox>
          <Grid x:Name="NewTimingFields" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="False">
            <StackPanel Spacing="4"><TextBlock Classes="eyebrow" Text="{local:Tr Create.Bpm}" /><TextBox x:Name="BpmValue" Classes="workbench-field" Text="150" AutomationProperties.Name="{local:Tr Create.Bpm}" /></StackPanel>
            <StackPanel Grid.Column="1" Spacing="4"><TextBlock Classes="eyebrow" Text="{local:Tr Create.Offset}" /><TextBox x:Name="OffsetValue" Classes="workbench-field" Text="0" AutomationProperties.Name="{local:Tr Create.Offset}" /></StackPanel>
          </Grid>
          <CheckBox x:Name="CopyScroll" Content="{local:Tr AddForm.CopyScroll}" />
          <TextBlock Classes="caption" Text="{local:Tr AddForm.EmptyNotes}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Height="1" Background="{DynamicResource Line}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="{local:Tr AddForm.Preview}" />
          <CheckBox x:Name="PreviewOverride" Content="{local:Tr AddForm.SetPreview}" IsCheckedChanged="PreviewChanged" />
          <Grid x:Name="PreviewFields" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="False">
            <StackPanel Spacing="4">
              <TextBlock Classes="eyebrow" Text="{local:Tr AddForm.PreviewStart}" />
              <TextBox x:Name="PreviewStart" Classes="workbench-field" AutomationProperties.Name="{local:Tr AddForm.PreviewStart}" TextChanged="PreviewChanged" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Classes="eyebrow" Text="{local:Tr AddForm.PreviewLength}" />
              <TextBox x:Name="PreviewLength" Classes="workbench-field" AutomationProperties.Name="{local:Tr AddForm.PreviewLength}" TextChanged="PreviewChanged" />
            </StackPanel>
          </Grid>
          <TextBlock x:Name="PreviewInfo" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Spacing="8">
      <ScrollViewer x:Name="FeedbackViewport" Height="32" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="Feedback" Classes="pink" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button x:Name="CancelButton" Classes="form-action secondary" Content="{local:Tr Create.Cancel}" Click="CancelClicked" ToolTip.Tip="Esc" />
        <Button x:Name="AddButton" Classes="form-action primary accent" Content="{local:Tr Create.Add}" Click="ConfirmClicked" ToolTip.Tip="Ctrl+Enter" />
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
