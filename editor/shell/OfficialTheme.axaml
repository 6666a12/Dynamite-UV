<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="https://irihi.tech/ursa">
  <Styles.Resources>
    <SolidColorBrush x:Key="ButtonDefaultBackground">#0E1528</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDefaultBorderBrush">#2A3560</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground">#1A2947</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDefaultPointeroverBorderBrush">#35E0FF</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDefaultPressedBackground">#14273D</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDefaultPressedBorderBrush">#FF4D8F</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground">#DFE6FF</SolidColorBrush>
    <x:Double x:Key="ButtonDefaultFontSize">13</x:Double>
    <SolidColorBrush x:Key="TextControlForeground">#DFE6FF</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBackground">#080C18</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrush">#2A3560</SolidColorBrush>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused">#35E0FF</SolidColorBrush>
    <ControlTheme x:Key="OfficialButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="13,5" />
    <Setter Property="FontSize" Value="13" />
    </ControlTheme>
  </Styles.Resources>
  <Style Selector="Button">
    <Setter Property="Theme" Value="{StaticResource OfficialButton}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.accent, u|IconButton.accent">
    <Setter Property="Background" Value="{DynamicResource Cyan}" />
    <Setter Property="Foreground" Value="{DynamicResource Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Cyan}" />
  </Style>
  <Style Selector="Button.ghost, u|IconButton.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.active, u|IconButton.active">
    <Setter Property="Foreground" Value="{DynamicResource Cyan}" />
    <Setter Property="Background" Value="#14273D" />
    <Setter Property="BorderBrush" Value="{DynamicResource Cyan}" />
  </Style>
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource OfficialFont}" />
  </Style>
  <Style Selector="TextBlock.eyebrow">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
  </Style>
  <Style Selector="TextBlock.cyan">
    <Setter Property="Foreground" Value="{DynamicResource Cyan}" />
  </Style>
  <Style Selector="TextBlock.pink">
    <Setter Property="Foreground" Value="{DynamicResource Pink}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{DynamicResource Cyan}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="ComboBox, NumericUpDown, TextBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <!-- ComboBox snapshots a ComboBoxItem's Content into SelectionBoxItem. Bind the
       selected label to the live item instead, without cycling selection or firing edits. -->
  <Style Selector="ComboBox.localized">
    <Setter Property="SelectionBoxItemTemplate">
      <DataTemplate>
        <TextBlock Text="{ReflectionBinding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="DockControl">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="FontFamily" Value="{DynamicResource OfficialFont}" />
  </Style>
  <Style Selector="DocumentTabStrip, ToolTabStrip, ToolChromeControl">
    <Setter Property="Background" Value="{DynamicResource Surface}" />
  </Style>
</Styles>
