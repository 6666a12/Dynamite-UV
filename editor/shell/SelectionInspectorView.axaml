<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:DynamiteUniverse.Editor.Shell"
             x:Class="DynamiteUniverse.Editor.Shell.SelectionInspectorView">
  <StackPanel Spacing="14">
    <TextBlock x:Name="Summary" Classes="caption" TextWrapping="Wrap" />
    <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <TextBlock Classes="section" Text="{local:Tr Batch.Transform}" VerticalAlignment="Center" />
          <local:ContextHelpButton Text="{local:Tr Batch.TransformHelp}" />
        </StackPanel>
      </Expander.Header>
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <StackPanel Spacing="4">
          <TextBlock Classes="eyebrow" Text="{local:Tr Inspector.BarTime}" />
          <ComboBox x:Name="TimeMode" Classes="workbench-field" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="TransformModeChanged">
            <ComboBoxItem Content="{local:Tr Batch.Offset}" />
            <ComboBoxItem Content="{local:Tr Batch.MoveStart}" />
          </ComboBox>
          <TextBox x:Name="TimeInput" Classes="workbench-field" Text="0" Watermark="+1/4" TextChanged="Changed" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="eyebrow" Text="{local:Tr Batch.Position}" />
          <TextBox x:Name="PositionInput" Classes="workbench-field" Text="0" Watermark="+0.2" TextChanged="Changed" />
        </StackPanel>
        <TextBlock x:Name="TransformError" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Spacing="4">
          <Button x:Name="ApplyTransformButton" Content="{local:Tr Batch.ApplyTransform}" Classes="primary" HorizontalAlignment="Stretch" Click="ApplyTransform" />
          <Button x:Name="ResetTransformButton" Content="{local:Tr Batch.Reset}" HorizontalAlignment="Stretch" Click="ResetTransform" />
        </StackPanel>
      </StackPanel>
    </Expander>
    <Border Height="1" Background="{DynamicResource Line}" />
    <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Classes="section" Text="{local:Tr Batch.Properties}" TextWrapping="Wrap" />
      </Expander.Header>
      <StackPanel Spacing="8" Margin="0,8,0,0">
        <StackPanel Spacing="4">
          <TextBlock x:Name="WidthLabel" Classes="eyebrow" Text="{local:Tr Inspector.Width}" />
          <ComboBox x:Name="WidthMode" Classes="workbench-field" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="WidthModeChanged">
            <ComboBoxItem Content="{local:Tr Batch.Set}" />
            <ComboBoxItem Content="{local:Tr Batch.Add}" />
          </ComboBox>
          <TextBox x:Name="WidthInput" Classes="workbench-field" TextChanged="WidthChanged" />
        </StackPanel>
        <StackPanel x:Name="PathScope" Spacing="4">
          <TextBlock Classes="eyebrow" Text="{local:Tr Batch.Scope}" />
          <ComboBox x:Name="WidthScope" Classes="workbench-field" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ScopeChanged">
            <ComboBoxItem Content="{local:Tr Batch.Head}" />
            <ComboBoxItem Content="{local:Tr Batch.WholePath}" />
          </ComboBox>
          <TextBlock x:Name="WidthWarning" Classes="caption" Text="{local:Tr Batch.WidthWarning}" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock x:Name="TrackLabel" Classes="eyebrow" Text="{local:Tr Inspector.Track}" VerticalAlignment="Center" />
            <local:ContextHelpButton Text="{local:Tr Batch.TrackHint}" />
          </StackPanel>
          <ComboBox x:Name="BatchTrack" Classes="workbench-field" HorizontalAlignment="Stretch" SelectionChanged="TrackChanged">
            <ComboBoxItem Content="{local:Tr Batch.Mixed}" />
            <ComboBoxItem Content="{local:Tr Inspector.LeftStage}" />
            <ComboBoxItem Content="{local:Tr Inspector.CenterStage}" />
            <ComboBoxItem Content="{local:Tr Inspector.RightStage}" />
          </ComboBox>
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock x:Name="TypeLabel" Classes="eyebrow" Text="{local:Tr Inspector.NoteType}" />
          <ComboBox x:Name="BatchType" Classes="workbench-field" HorizontalAlignment="Stretch" SelectionChanged="TypeChanged">
            <ComboBoxItem Content="{local:Tr Batch.Mixed}" />
            <ComboBoxItem Content="{local:Tr Inspector.Tap}" />
            <ComboBoxItem Content="{local:Tr Inspector.Drag}" />
            <ComboBoxItem Content="{local:Tr Inspector.ExTap}" />
          </ComboBox>
          <TextBlock x:Name="TypeWarning" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="PropertiesError" Classes="caption" TextWrapping="Wrap" IsVisible="False" />
        <StackPanel Spacing="4">
          <Button x:Name="ApplyPropertiesButton" Classes="primary" HorizontalAlignment="Stretch" Click="ApplyProperties" />
          <Button x:Name="ResetPropertiesButton" Content="{local:Tr Batch.Reset}" HorizontalAlignment="Stretch" Click="ResetProperties" />
        </StackPanel>
      </StackPanel>
    </Expander>
    <Expander HorizontalContentAlignment="Stretch">
      <Expander.Header>
        <TextBlock Classes="section" Text="{local:Tr Batch.Objects}" TextWrapping="Wrap" />
      </Expander.Header>
      <ListBox x:Name="SelectedObjects" MaxHeight="180" Margin="0,8,0,0" SelectionChanged="LocateSelected" />
    </Expander>
  </StackPanel>
</UserControl>
