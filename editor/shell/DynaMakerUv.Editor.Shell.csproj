<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DynamiteUniverse.Editor.Shell</RootNamespace>
    <AssemblyName>DynaMakerUv.Editor.Shell</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <AvaloniaResource Include="../assets/fonts/SpaceGrotesk-Medium.ttf" Link="Assets/SpaceGrotesk-Medium.ttf" />
    <EmbeddedResource Include="Localization/*.json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../shared/DynamiteUniverse.Shared.csproj" />
    <ProjectReference Include="../../tools/chart-editor-core/ChartEditor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Dock.Avalonia" Version="12.1.0.13" />
    <PackageReference Include="Dock.Model.Avalonia" Version="12.1.0.13" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.13" />
    <PackageReference Include="SukiUI" Version="7.0.2-nightly20261029.502" />
    <PackageReference Include="SukiUI.Motion" Version="7.0.2-nightly20261029.502" />
    <PackageReference Include="Irihi.Ursa" Version="2.3.0" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.3.0" />
  </ItemGroup>
</Project>
