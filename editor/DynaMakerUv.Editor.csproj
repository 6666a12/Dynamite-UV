    <Compile Include="../client/scripts/ui/UiMotionMode.cs" Link="GameUi/UiMotionMode.cs" />
    <Compile Include="../client/scripts/ui/UiGeometry.cs" Link="GameUi/UiGeometry.cs" />
    <Compile Include="../client/scripts/ui/CutPanel.cs" Link="GameUi/CutPanel.cs" />
    <Compile Include="../client/scripts/ui/CoverPlaceholder.cs" Link="GameUi/CoverPlaceholder.cs" />
    <Compile Include="../client/scripts/game/NoteVisualSpec.cs" Link="GameUi/NoteVisualSpec.cs" />
    <Compile Include="../client/scripts/game/GameplayBackdrop.cs" Link="GameUi/GameplayBackdrop.cs" />
    <Compile Include="../client/scripts/game/GameplayHitBloom.cs" Link="GameUi/GameplayHitBloom.cs" />
    <Compile Include="../client/scripts/game/GameplayStageRenderer.cs" Link="GameUi/GameplayStageRenderer.cs" />
    <Compile Include="../client/scripts/game/GameplayVisualMapper.cs" Link="GameUi/GameplayVisualMapper.cs" />
