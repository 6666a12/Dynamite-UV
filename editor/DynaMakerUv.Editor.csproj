    <RollForward>LatestMajor</RollForward>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DynamiteUniverse.Editor</RootNamespace>
